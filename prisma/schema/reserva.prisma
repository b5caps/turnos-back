enum EstadoReserva {
  CONFIRMADA
  EN_CURSO
  FINALIZADA
  CANCELADA
  VENCIDA
}

model Reserva {
  id                   Int           @id @default(autoincrement())
  usuarioId            Int
  salaId               Int
  notebookId           Int?
  creadaPorId          Int?
  cantidadPersonas     Int
  fechaHoraInicio      DateTime
  fechaHoraFin         DateTime
  fechaLimiteCheckIn   DateTime
  estado               EstadoReserva @default(CONFIRMADA)
  fechaHoraCheckIn     DateTime?
  fechaHoraCheckOut    DateTime?
  fechaHoraCancelacion DateTime?
  motivoCancelacion    String?
  observacion          String?
  creadoEn             DateTime      @default(now())
  actualizadoEn        DateTime      @updatedAt

  usuario        Usuario        @relation("ReservaUsuario", fields: [usuarioId], references: [id])
  sala           Sala           @relation(fields: [salaId], references: [id])
  notebook       Notebook?      @relation(fields: [notebookId], references: [id])
  creadaPor      Usuario?       @relation("ReservaCreador", fields: [creadaPorId], references: [id])
  notificaciones Notificacion[]
}
