enum TipoCancelacion {
  USUARIO
  ADMINISTRADOR
  AUSENCIA
}

enum OrigenCheckIn {
  QR
  ADMIN
}

model Reserva {
  id                    Int              @id @default(autoincrement())
  usuarioId             Int
  usuario               Usuario          @relation(fields: [usuarioId], references: [id])
  fechaHoraInicio       DateTime
  fechaHoraFin          DateTime
  fechaLimiteCheckIn    DateTime
  controlAsistencia    Boolean @default(true)
  fechaHoraConfirmacion DateTime?
  fechaHoraCancelacion  DateTime?
  motivoCancelacion     String?
  tipoCancelacion       TipoCancelacion?
  fechaHoraCheckIn      DateTime?
  origenCheckIn         OrigenCheckIn?
  checkInRegistradoPorId Int?
  checkInRegistradoPor   Usuario? @relation("CheckInRegistradoPor", fields: [checkInRegistradoPorId], references: [id], onDelete: SetNull)
  fechaHoraCheckOut     DateTime?
  fechaCreacion         DateTime         @default(now())
  observacion           String?
  recursos              ReservaRecurso[]

  @@index([fechaLimiteCheckIn])
}

model ReservaPendiente {
  id                     Int                       @id @default(autoincrement())
  usuarioId              Int
  usuario                Usuario                   @relation(fields: [usuarioId], references: [id])
  fechaHoraDeseadaInicio DateTime
  fechaHoraDeseadaFin    DateTime
  fechaHoraSolicitud     DateTime                  @default(now())
  recursos               ReservaPendienteRecurso[]
}
