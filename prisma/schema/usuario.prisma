enum Rol {
  ADMIN
  UTN
  EXTERNO
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  apellido      String
  email         String   @unique
  documento     String   @unique
  telefono      String?
  passwordHash  String
  rol           Rol
  legajo        String?  @unique
  carrera       String?
  esDocente     Boolean?
  organizacion  String?
  localidad     String?
  provincia     String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  reservas        Reserva[]      @relation("ReservaUsuario")
  reservasCreadas Reserva[]      @relation("ReservaCreador")
  notificaciones  Notificacion[]
}
