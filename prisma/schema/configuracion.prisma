// prisma/schema/configuracion.prisma

model Configuracion {
  id                         Int      @id @default(1)
  minutosApertura            Int      @default(480)  // 08:00
  minutosCierre              Int      @default(1320) // 22:00
  tiempoMaximoAntelacionDias Int      @default(30)
  duracionMinimaMinutos      Int      @default(30)
  duracionMaximaMinutos      Int      @default(240)
  minutosGraciaCheckIn       Int      @default(15)
  actualizadoEn              DateTime @updatedAt
}

enum TipoEntidadAuditoria {
  ESPACIO
  CONFIGURACION
}

enum AccionEntidadAuditoria {
  CREACION
  ACTUALIZACION
  DESACTIVACION
  ELIMINACION
}

model EntidadBitacora {
  id          Int                    @id @default(autoincrement())
  entidadTipo TipoEntidadAuditoria
  entidadId   Int
  accion      AccionEntidadAuditoria
  actorId     Int?
  actor       Usuario?               @relation("EntidadesBitacora", fields: [actorId], references: [id], onDelete: SetNull)
  actorRol    Rol
  fechaHora   DateTime               @default(now())
  detalle     String?

  @@index([entidadTipo, entidadId, fechaHora, id])
}

model Feriado {
  id            Int      @id @default(autoincrement())
  fecha         String   @unique
  nombre        String
  creadoPorId   Int?
  creadoPor     Usuario? @relation("FeriadosCreados", fields: [creadoPorId], references: [id], onDelete: SetNull)
  fechaCreacion DateTime @default(now())

  @@index([fecha])
}
